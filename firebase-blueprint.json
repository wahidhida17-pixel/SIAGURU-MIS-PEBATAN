  "firestore": {
    "/learningPlans/{cpId}": {
      "schema": "LearningPlan",
      "description": "Capaian Pembelajaran collections"
    },
    "/learningObjectives/{tpId}": {
      "schema": "LearningObjective",
      "description": "Tujuan Pembelajaran collections"
    },
    "/atp/{atpId}": {
      "schema": "ATP",
      "description": "Alur Tujuan Pembelajaran collections"
    },
    "/prota/{protaId}": {
      "schema": "Prota",
      "description": "Program Tahunan collections"
    },
    "/promes/{promesId}": {
      "schema": "Promes",
      "description": "Program Semester collections"
    },
    "/modules/{moduleId}": {
      "schema": "ModuleAjar",
      "description": "Modul Ajar collections"
    },
    "/kktp/{kktpId}": {
      "schema": "KKTP",
      "description": "KKTP collections"
    },
    "/academicCalendar/{calendarId}": {
      "schema": "AcademicCalendar",
      "description": "Kalender akademik madrasah"
    },
    "/assessments/{assessmentId}": {
      "schema": "Assessment",
      "description": "Data asesmen pembelajaran guru"
    },
    "/grades/{gradeId}": {
      "schema": "Grade",
      "description": "Data nilai siswa per asesmen"
    },
    "/assessmentConfigs/{configId}": {
      "schema": "AssessmentConfig",
      "description": "Konfigurasi penilaian dan pembobotan nilai"
    },
    "/studentDescriptions/{descId}": {
      "schema": "StudentDescription",
      "description": "Deskripsi capaian pembelajaran siswa"
    },
    "/assessmentFollowUps/{followUpId}": {
      "schema": "AssessmentFollowUp",
      "description": "Data tindak lanjut remedial dan pengayaan"
    },
    "/finalScores/{scoreId}": {
      "schema": "FinalScore",
      "description": "Data rekapitulasi nilai akhir siswa"
    }
